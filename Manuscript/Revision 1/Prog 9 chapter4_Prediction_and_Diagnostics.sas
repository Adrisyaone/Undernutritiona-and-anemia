
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

*	ANALYSIS OF THE CLASSROOM DATA - Chapter 4;

/*** The Example focuses on the analysis of the Classrooom data: 
	+ a three-level clustered dataset, 
	+ where the units of analysis is the studentss,
	
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/



/* Import external data to the libname data */
*====================================================================;


libname Learn "C:\Users\bdhikari\Downloads";

* View the dataset;
proc print data=Learn.classroom (obs=10);
run;

*Clean the dataset;
data classroom;
set Learn.classroom;
if mathknow='.' or mathprep='.' then delete;
run;

* Sort dataset by schoolid and classid;
	* This organize the dataset as classid within schoolid; 
proc sort data = classroom;
   by schoolid classid;
run;

* Performs decsiprtives to confirm current dataset organization;
Proc means data=Classroom;
 class Schoolid Classid;
 var mathgain;
run;



/*Model diagnosis */

* NOTE:

The SOLUTIONR ~ provide random predictions (BLUPS) for random factors;

ods exclude SolutionR;
ods output SolutionR=Eblups_4_2; *The EBLUPs are output into this file;
proc mixed data = Learn.classroom noclprint covtest;
   class classid schoolid;
   model mathgain = mathkind sex minority ses /
	residual influence (iter=5 effect=schoolid est) solution outpred = pdat1;
   random  schoolid /solution;
   random classid(schoolid) / solution;
run;


/*THE PLOTS

1. Normality of resiuduals is sustained, but independce and equality of 
	the residuals are not met.

2. The Restricted Likelihood Distance (RLD): 
	-	Helps identify how much each higher-level unit (school, class) 
		influences the overall model fit under RML estimation.
	-	As mentioned in previous classes, the larger the RLD value, the more
		the model’s likelihood changes when that cluster is omitted 
		i.e that cluster has greater influence on model estimation.

3.	The CovRatio (covariance ratio) Fixed Effects:
	-	Measures how much the precision of the fixed-effect estimates 
		changes when a cluster (a school or class) is deleted from the model.

4.	Interpretation of the covRatio 
		a. Look for outliers — clusters whose CovRatio values are much
			higher or lower than the rest.
		b. Values near 1.0 mean low influence, while values far from 1.0 
			indicate clusters that are influential on the fixed-effect estimates.
		c.	covRatio=1 (cluster has little or no influence on the precision).
			covRatio <1 (Removing the cluster increases precision (reduces covariance)
				i.e the cluster adds noise.
			coveRatio >1 (Removing the cluster decreases precision (increases covariance)
				i.e the cluster provides valuable information.

5. The same interpretations holds for covRation of covariances.

====================================== */


/* To view the EBLUPs (Empirical Best Linear Unbiased Predictors),
and the Predicted values, run the following set of code.
*/

*View the EBLUPs;
proc print data=Eblups_4_2;
run;

*View the Predicted values;
proc print data=pdat1;
run;



/*Figure 4.7: Normal QQ Plot of random effects of each classroom*/

* The dataset generated by ODS creates a new variable named 
	- EFFECT SCHOOLID for random effect of SCHOOLS
	- CLASSSID(SCHOOL)for prediction of classes within School;

title "Figure 4.7 - EBLUPs of the random classroom effects, Model 4.2";
proc univariate data=eblups_4_2 noprint;
   where effect="classid(schoolid)"; 
   var estimate;
   qqplot / normal (mu=est sigma=est);
   format estimate 5.2;
run;

* NOTE: 	No evidence of any outliers in the random classroom effects, 
			and the distribution of the EBLUPs for the random classroom 
			effects is approximately normal.;

/*Figure 4.8: Normal QQ Plot of predicted random school effects*/
title "Figure 4.8 - EBLUPs of the random school effects, Model 4.2";
proc univariate data=eblups_4_2 noprint;
   where effect="schoolid"; 
   var estimate;
   qqplot / normal (mu=est sigma=est);
   format estimate 5.2;
run;

* NOTE: 	No evidence of any outliers in the random school effects, 
			and the distribution of the EBLUPs for the random school 
			effects is approximately normal.;

/*Figure 4.9: Normal QQ Plot of Level 1 (Conditional) Residuals*/
title "Figure 4.9 - QQ plot of the residuals, Model 4.2";
proc univariate data=pdat1 noprint;
   var resid;
   qqplot / normal (mu=est sigma=est);
   format resid 5.;
run;

* NOTE: 	We see a deviation from the line at the tails of the distribution,
			which suggests outliers at the tail distribution of the residuals.
			There appear to be small sets of extreme negative and positive 
			residuals that may warrant further investigation;


/*Figure 4.10: Scatterplot of Conditional Residuals vs. Predicted Values*/
title "Figure 4.10 - Residual vs. fitted plot";
goptions reset=all;
symbol1 color = black value=circle ;
proc gplot data=pdat1;
  plot resid*pred / vref=0  lvref=3 ;
run; 
quit;
/* vref: horizontal reference level location;
	lvref: line type for the reference line; 3: dashed line;

NOTE:
1.	We see evidence of non-constant variance in the residual in Fig. 4.10.
 
*/




